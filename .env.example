# IMPORTANT:
# - Copy this file to .env before use
# - DO NOT put real credentials in .env.example
# - Never commit .env to version control


# Local development credentials for the default SeaweedFS setup.
# These credentials are safe to share and can be used as-is locally.
S3_ACCESS_KEY=mlops-local
S3_SECRET_KEY=mlops-local-secret

# If connecting to an external S3-compatible service such as AWS,
# replace the values above in .env with your own credentials.


MLFLOW_SERVER_ALLOWED_HOSTS=localhost:5000,mlflow:5000
MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=None

# For local running
API_URL=http://localhost:8000
MLFLOW_URL=http://localhost:5000
